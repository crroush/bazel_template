common --enable_bzlmod
build --incompatible_strict_action_env
test --test_output=errors
build --sandbox_default_allow_network=false

# Build modes apply to all languages; additional C/C++ flags are explicit.
build:debug --compilation_mode=dbg
build:debug --strip=never
build:dbg --config=debug
build:opt --compilation_mode=opt
build:release --config=opt
build:minsize --config=opt
build:minsize --copt=-Os

# Opt-in warnings for our code, not external dependencies. Keep exceptions:
# pybind11 needs them for Python/C++ exception conversion.
build:strict --per_file_copt=examples/.*@-Wall,-Wextra,-Werror

# C/C++ sanitizer configurations; run native cc_test targets with these.
# Stable Rust and the downloaded Python interpreter are not instrumented.
build:asan --config=debug
build:asan --copt=-fsanitize=address
build:asan --copt=-fno-omit-frame-pointer
build:asan --linkopt=-fsanitize=address
test:asan --test_env=ASAN_OPTIONS=detect_leaks=1:halt_on_error=1
build:ubsan --compilation_mode=dbg
build:ubsan --strip=never
build:ubsan --copt=-fsanitize=undefined
build:ubsan --copt=-fno-sanitize-recover=undefined
build:ubsan --linkopt=-fsanitize=undefined
test:ubsan --test_env=UBSAN_OPTIONS=print_stacktrace=1:halt_on_error=1

# Native coverage for C++, Python, Rust, and JavaScript in one LCOV report.
# Rust's inline unit tests require instrument_test_targets.
coverage --combined_report=lcov
coverage --experimental_use_llvm_covmap
coverage --experimental_generate_llvm_lcov
coverage --instrumentation_filter=^//examples[/:]
coverage --instrument_test_targets
coverage --cache_test_results=no

build:arm64 --platforms=//platforms:linux_arm64
build:arm64 --cpu=aarch64

# Optional machine-specific caches/credentials belong here, not in Git.
try-import %workspace%/.bazelrc.local

# CUDA uses the pinned C++ toolchain, never an ambient clang from PATH.
common --repo_env=CUDA_COMPILER_USE_CC_TOOLCHAIN=true
build:cuda --@rules_cuda//cuda:compiler=clang
build:cuda --@rules_cuda//cuda:archs=compute_80:sm_80,compute_80
build:cuda --@rules_cuda//cuda:runtime=@cuda//:cuda_runtime_static
# Split CUDA redistributables lack cuda.h at Clang's toolkit probe path.
# Pin PTX to the 12.8 assembler's supported ISA instead of Clang's newest ISA.
build:cuda --@rules_cuda//cuda:copts=--cuda-feature=+ptx87
