module(
    name = "polyglot_template",
    version = "0.1.0",
    bazel_compatibility = [
        ">=7.6.1",
        "<8.0.0",
    ],
)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_python", version = "1.5.0")
bazel_dep(name = "pybind11_bazel", version = "2.13.6")
bazel_dep(name = "rules_rust", version = "0.61.0")
bazel_dep(name = "aspect_rules_js", version = "2.4.2")
bazel_dep(name = "aspect_bazel_lib", version = "2.19.3")
bazel_dep(name = "rules_nodejs", version = "6.5.2")
bazel_dep(name = "toolchains_llvm", version = "1.13.0")

# Track individual sysroot files instead of an opaque source directory.
single_version_override(
    module_name = "toolchains_llvm",
    version = "1.13.0",
    patches = ["//tools/patches:sysroot-files.patch"],
    patch_strip = 1,
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    configure_coverage_tool = True,
    is_default = True,
    python_version = "3.12",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    experimental_index_url = "https://pypi.org/simple",
    hub_name = "pypi",
    python_version = "3.12",
    requirements_by_platform = {
        "//examples/python:requirements.lock": "linux_x86_64,linux_aarch64",
    },
)
use_repo(pip, "pypi")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    extra_target_triples = ["aarch64-unknown-linux-gnu"],
    versions = ["1.85.1"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "22.14.0")
use_repo(node, "nodejs_toolchains")

register_toolchains("@nodejs_toolchains//:all")

# Chromium's Debian Bullseye sysroots pin target headers, libc, and libstdc++.
sysroot = use_repo_rule("@toolchains_llvm//toolchain:sysroot.bzl", "sysroot")

sysroot(
    name = "linux_x86_64_sysroot",
    sha256 = "f851add76bdae472fb6c94b4f920bc4a132d85ac607951391297f636af7e934e",
    urls = ["https://commondatastorage.googleapis.com/chrome-linux-sysroot/f851add76bdae472fb6c94b4f920bc4a132d85ac607951391297f636af7e934e"],
)

sysroot(
    name = "linux_arm64_sysroot",
    sha256 = "278c36fe3a785d7f89fbe3f46956899a3bd49fe665f68dc667d6f626a951fcd6",
    urls = ["https://commondatastorage.googleapis.com/chrome-linux-sysroot/278c36fe3a785d7f89fbe3f46956899a3bd49fe665f68dc667d6f626a951fcd6"],
)

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    name = "llvm_toolchain",
    cxx_standard = {"": "c++20"},
    extra_llvm_distributions = {
        "LLVM-23.1.6-Linux-ARM64.tar.xz": "e9daa167da28b9e31d30046f05f98e3e7da3647cdbe1c1863e8b223c07ccf291",
        "LLVM-23.1.6-Linux-X64.tar.xz": "bd4d1c434ff69ef06d19e7934c04708da677e5f2eb51f5bcf052ab91818f0094",
    },
    llvm_version = "23.1.6",
    stdlib = {"": "dynamic-stdc++"},
)
llvm.sysroot(
    name = "llvm_toolchain",
    label = "@linux_x86_64_sysroot//sysroot",
    targets = ["linux-x86_64"],
)
llvm.sysroot(
    name = "llvm_toolchain",
    label = "@linux_arm64_sysroot//sysroot",
    targets = ["linux-aarch64"],
)
use_repo(llvm, "llvm_toolchain", "llvm_toolchain_llvm")

register_toolchains("@llvm_toolchain//:all")

# abi3 avoids probing an ambient Python installation during Rust compilation.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.spec(package = "pyo3", version = "=0.23.5", features = ["extension-module", "abi3-py312"])
crate.annotation(crate = "pyo3-build-config", build_script_env = {"PYO3_NO_PYTHON": "1"})
crate.from_specs(
    lockfile = "//examples/pyo3:Cargo.Bazel.lock",
    cargo_lockfile = "//examples/pyo3:Cargo.lock",
    supported_platform_triples = ["x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu"],
)
use_repo(crate, "crates")
